{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Shanghai",
  "labels": ["dependencies"],
  "commitMessagePrefix": "fix(deps)",
  "commitMessageTopic": "{{depName}}",
  "rangeStrategy": "bump",
  "lockFileMaintenance": { "enabled": false },
  "prConcurrentLimit": 20,
  "prHourlyLimit": 20,
  "autoReplaceGlobalMatch": true,
  "packageRules": [
    {
      "description": "Frozen groups: pinned versions change only by hand",
      "matchFileNames": [
        "config/clickhouse-images.yaml",
        "config/flink-images.yaml",
        "config/kafka-ui-images.yaml",
        "config/linyi-base-images.yaml"
      ],
      "enabled": false
    },
    {
      "description": "node 22: update only within major 22, so the 22/24/26 lines never collapse into one",
      "matchDepNames": ["node"],
      "matchCurrentVersion": "/^22\\./",
      "allowedVersions": "/^22\\./"
    },
    {
      "description": "node 24: update only within major 24, so the 22/24/26 lines never collapse into one",
      "matchDepNames": ["node"],
      "matchCurrentVersion": "/^24\\./",
      "allowedVersions": "/^24\\./"
    },
    {
      "description": "node 26: update only within major 26, so the 22/24/26 lines never collapse into one",
      "matchDepNames": ["node"],
      "matchCurrentVersion": "/^26\\./",
      "allowedVersions": "/^26\\./"
    }
  ],
  "customManagers": [
    {
      "description": "Update container image tags in config/*-images.yaml; with autoReplaceGlobalMatch the version is replaced in both the source tag and the destination tag",
      "customType": "regex",
      "fileMatch": ["^config/.*-images\\.yaml$"],
      "matchStrings": [
        "(?m)^(?<depName>[^\\s:#][^:\\s]*):(?<currentValue>[A-Za-z0-9][A-Za-z0-9._-]*):\\s\"[^\"]*\"\\s*$"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
